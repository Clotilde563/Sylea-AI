{
  "productName": "Sylea Agent",
  "version": "1.0.0",
  "identifier": "com.sylea.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sylea Agent",
        "width": 720,
        "height": 820,
        "minWidth": 240,
        "minHeight": 80,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "Assistant AI Syléa — moteur OpenClaw local",
    "longDescription": "Syléa installe son moteur AI OpenClaw (licence MIT) et connecte vos skills ClawHub préférés — calendrier, email, notes, communication, tâches — pour vous accompagner dans vos décisions au quotidien.",
    "category": "Productivity",
    "copyright": "(c) 2026 Syléa",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "entitlements.plist",
      "frameworks": []
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Clotilde563/Sylea-AI/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": ""
    },
    "deep-link": {
      "desktop": {
        "schemes": ["sylea"]
      },
      "mobile": [
        {
          "host": "sylea.ai",
          "pathPrefix": ["/auth/callback"]
        }
      ]
    }
  }
}
