{
  "productName": "Sylea Agent",
  "version": "1.0.0",
  "identifier": "com.sylea.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sylea Agent",
        "width": 720,
        "height": 820,
        "minWidth": 240,
        "minHeight": 80,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Assistant AI Sylea — moteur OpenClaw local",
    "longDescription": "Sylea installe son moteur AI OpenClaw (licence MIT, 38 outils) et connecte vos skills ClawHub preferes — calendrier, email, notes, communication, taches — pour vous accompagner dans vos decisions au quotidien.",
    "category": "Productivity",
    "copyright": "(c) 2026 Sylea"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Clotilde563/Sylea-AI/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": ""
    }
  }
}
