# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional — OpenAI TTS for voice
OPENAI_API_KEY=sk-...

# Optional — Email notifications
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password

# Optional — OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback

# Frontend base URL (utilise par OAuth callback + emails)
FRONTEND_BASE_URL=http://localhost:5173

# Database — SQLite (dev local) ou PostgreSQL (prod multi-user)
# Mode SQLite (defaut) : juste DATABASE_PATH
DATABASE_PATH=data/sylea.db
# Mode PostgreSQL (prod) : decommenter DATABASE_URL pour basculer automatiquement
# - Alembic upgrade head se lance au demarrage de l'API
# - DatabaseManager utilise RawDBProxy au lieu de sqlite3
# - Repositories synchrones delegent aux versions async PG
# DATABASE_URL=postgresql://user:password@host:5432/sylea

# JWT Secret (CRITIQUE en prod - sinon fallback dev predictable)
# Generer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# SECRET_KEY : fallback derivation pour SYLEA_CREDENTIALS_MASTER_KEY si absent.
# En prod, definir SYLEA_CREDENTIALS_MASTER_KEY a la place.
SECRET_KEY=

# Chiffrement Fernet pour les credentials tiers (Google/GitHub/etc.)
# Generer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SYLEA_CREDENTIALS_MASTER_KEY=

# Admin access : liste d'emails (separes par ,) qui ont acces a /admin
SYLEA_ADMIN_EMAILS=admin@example.com

# CORS origins (comma-separated, for production)
CORS_ORIGINS=https://your-frontend.vercel.app

# Scheduler cron (cron jobs Agent 3) - DESACTIVE par defaut (cost-safety)
# Active uniquement en prod via SYLEA_SCHEDULER_ENABLED=true
SYLEA_SCHEDULER_ENABLED=false
# Budget quotidien max (USD) pour les appels Claude depuis le scheduler
SYLEA_SCHEDULER_DAILY_CAP_USD=0.50

# Stripe (paiements abonnements)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# ─── API keys recherche web (optionnelles) ───────────────────────────────────
BRAVE_SEARCH_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
XAI_API_KEY=

# ─── Push notifications Web Push (VAPID) ─────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:contact@example.com

# ─── Voice (faster-whisper local STT) ────────────────────────────────────────
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE=int8
FASTER_WHISPER_LANG=fr

# ─── Rate limits Agent 3 (par minute) ────────────────────────────────────────
# AGENT3_RATELIMIT_SEARCH_PER_MIN=20
# AGENT3_RATELIMIT_WEB_FETCH_PER_MIN=20
# AGENT3_RATELIMIT_EMAIL_PER_MIN=10
# AGENT3_RATELIMIT_CAL_PER_MIN=20
# AGENT3_RATELIMIT_DRIVE_PER_MIN=20
# AGENT3_RATELIMIT_CRON_PER_MIN=5
# AGENT3_RATELIMIT_CUSE_PER_MIN=2
# AGENT3_RATELIMIT_X_SEARCH_PER_MIN=10
# AGENT3_DISABLE_RATELIMIT=false
# AGENT3_COST_HARD_CAP_USD=10.00

# ─── Retention policies (jours) ──────────────────────────────────────────────
SYLEA_RETENTION_MESSAGES_DAYS=180
SYLEA_RETENTION_EVENTS_DAYS=180
SYLEA_RETENTION_FIGURES_DAYS=30
SYLEA_RETENTION_UPLOADS_DAYS=90
SYLEA_RETENTION_AUDIT_DAYS=365

# ─── Chat rate limit (anti-spam) ─────────────────────────────────────────────
SYLEA_CHAT_MAX_RPM=20
SYLEA_CHAT_BURST=5
SYLEA_DISABLE_CHAT_RATELIMIT=false

# ─── Scheduler avance ────────────────────────────────────────────────────────
SYLEA_SCHEDULER_MODEL=claude-haiku-4-5-20251001

# ─── OpenClaw (optionnel — service externe pour outils additionnels) ─────────
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_CLI_PATH=
OPENCLAW_CONFIG_PATH=
OPENCLAW_PORT=18789
OPENCLAW_TIMEOUT_SIMPLE=30
OPENCLAW_TIMEOUT_HEAVY=120
OPENCLAW_TIMEOUT_AGENTIC=300

# ─── ClawHub (skills tiers) ──────────────────────────────────────────────────
CLAWHUB_CLI_PATH=
SYLEA_USER_SKILLS_ROOT=

# ─── Sandbox Python (Agent 3 PYTHON_EXEC) ────────────────────────────────────
SANDBOX_TIMEOUT=30
SANDBOX_MAX_OUTPUT=100000

# ─── Self-reflection (Agent 3 meta) ──────────────────────────────────────────
SYLEA_REFLECTION_ENABLED=true
SYLEA_REFLECTION_MIN_CHARS=2000
SYLEA_REFLECTION_MIN_TOOL_USES=2

# ─── Read replica PG (lecture seule, optionnel) ──────────────────────────────
# DATABASE_URL_READ=postgresql+asyncpg://user:pass@read-replica:5432/sylea
